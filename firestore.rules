rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin is determined by email address on the auth token.
    // Keep this list in sync with ADMIN_EMAILS in AuthContext.jsx.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'sahilnikam133@gmail.com',
        'sahilnikam1212@gmail.com',
        'khushiraygade76666@gmail.com',
        'founder.vrikaan@gmail.com',
        'cofounder.vrikaan@gmail.com'
      ];
    }

    // ─── users ───────────────────────────────────────────────────
    // Owner reads + writes own profile, EXCEPT privileged fields (plan/role/
    // entitlements) which are server-owned (verify-payment / admin via Admin
    // SDK, which bypasses rules). Closes the client self-grant exploit.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['plan','role','familyRole','planExpiresAt',
                      'planActivatedAt','planBilling','lastOrderId']));

      // Payments subcollection — READ-ONLY for the owner. The record is written
      // by the Cashfree grant path via the Admin SDK (which bypasses rules), so
      // a client never needs create access. It used to have it, which let any
      // user author arbitrary permanent rows in their own billing history —
      // rows that feed invoice generation and revenue analytics.
      match /payments/{payId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // Tool usage history — owner only.
      match /toolHistory/{histId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // Registered devices — owner only.
      match /devices/{deviceId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // Personal API keys — owner only.
      match /apikeys/{keyId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // Activity log — owner only.
      match /activity/{actId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // Security reports — owner only.
      match /reports/{repId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // ─── leaderboard ─────────────────────────────────────────────
    // Public Academy leaderboard. Any signed-in user can read all entries;
    // each user may write ONLY their own doc (keyed by uid). XP is a vanity
    // metric (no entitlement attached), so client-write is acceptable here.
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ─── referrals ───────────────────────────────────────────────
    // Each user owns exactly one referral-code document keyed by their uid.
    // Any signed-in user can READ this collection (so signup can look up
    // code owners), but only the owner can create / modify their own doc.
    match /referrals/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ─── referral_signups ────────────────────────────────────────
    // New signups record a tracking entry.
    // The referred user (self) creates the entry.
    // The referrer or the referred user can read their own entries.
    match /referral_signups/{sigId} {
      allow read: if isSignedIn() && (
        resource.data.referredBy == request.auth.uid ||
        resource.data.referredUser == request.auth.uid ||
        isAdmin()
      );
      // Creator must set referredUser == their own uid (prevents spoofing).
      allow create: if isSignedIn()
        && request.resource.data.referredUser == request.auth.uid
        && request.resource.data.referredBy != request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── usage ───────────────────────────────────────────────────
    // Document ID format: `{uid}_{YYYY-MM-DD}`.
    // Only the owner (uid prefix) may read/write their own usage doc.
    match /usage/{docId} {
      allow read, write: if isSignedIn()
        && docId.split('_')[0] == request.auth.uid;
    }

    // ─── api_tokens ──────────────────────────────────────────────
    // Public-by-id-only mirror of /users/{uid}/apikeys/{id} so Vercel
    // serverless functions can validate Bearer tokens by GETting the
    // exact doc id (the token itself). Listing is blocked because the
    // doc ID *is* the secret. Only the owner uid can write.
    // This mirror carries NO tier information. It used to store a `plan` field
    // that the API trusted, which let a free account mint itself an
    // "enterprise" key simply by writing the field it wanted — the same
    // self-grant that `users/{uid}.plan` already blocks. The API now resolves
    // the tier from the owner's user record on every call; the rule below
    // makes sure the stale field can't come back.
    match /api_tokens/{token} {
      allow get: if true;        // single-doc read by exact token id
      allow list: if false;      // never list — would leak all tokens
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['plan']);
      // Update forbids CHANGING plan rather than its presence: tokens minted
      // before this rule still carry a stale `plan`, and a presence check
      // would reject their revocation (active:false) and strand them.
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ─── digest_subscribers ──────────────────────────────────────
    // Public-read so the weekly-digest cron can list opt-ins via the
    // public REST API without a service account key (org policy
    // blocks key creation). Each doc only contains the fields the
    // user already exposes elsewhere (name, email) — no sensitive
    // data leaks. Users can only read their own subscription, plus
    // the cron can list all (the public API allows list when read
    // is allowed without auth).
    match /digest_subscribers/{uid} {
      // Was public-read (email harvest risk). Now owner/admin only — the cron
      // reads via Admin SDK (bypasses rules), so no public access needed.
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ─── teams ───────────────────────────────────────────────────
    // A user can READ a team if they're listed in its members map.
    // All WRITES go through the server (api/tools.js team-* handlers)
    // which run as the Admin SDK and bypass these rules; client writes
    // are blocked so members can't escalate themselves.
    match /teams/{teamId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create, update, delete: if false;
    }

    // ─── teamInvites ─────────────────────────────────────────────
    // Read by the invitee (matched by their auth email) so the dashboard
    // can show pending invites. All writes server-side via team-invite.
    match /teamInvites/{inviteId} {
      allow get, list: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // ─── familyInvites ───────────────────────────────────────────
    // Same model as teamInvites: invitee reads their own, family owner
    // reads invites they created. All writes go through server handlers
    // (family-invite, family-accept-invite).
    match /familyInvites/{inviteId} {
      allow get, list: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // ─── families ────────────────────────────────────────────────
    // Members can read their own family doc; writes are server-only.
    // Members map is stored as `members: { [uid]: role }` so we check
    // membership via dot-notation field existence.
    match /families/{familyId} {
      allow get: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.members
      );
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ─── coupons ─────────────────────────────────────────────────
    // Server-only access — Checkout now validates via /api/tools?tool=
    // coupon-validate (uses admin SDK). Client-side reads blocked so anon
    // users can't probe individual codes.
    match /coupons/{code} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─── leads ───────────────────────────────────────────────────
    // Enterprise walkthrough leads — written server-only (enterprise-lead
    // handler via Admin SDK). Contains contact details; never client-readable.
    match /leads/{leadId} {
      allow read, write: if false;
    }

    // ─── orders ──────────────────────────────────────────────────
    // Payment idempotency + audit records, keyed by Cashfree orderId. Written
    // ONLY by the server (verify-payment / cashfree-webhook via Admin SDK,
    // which bypasses rules). No client access — the orders/{orderId} guard is
    // what makes plan grants single-shot, so it must never be client-writable.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // ─── certificates ────────────────────────────────────────────
    // Academy certificates, written ONLY by cert-register via the Admin SDK
    // and read back through the public cert-verify endpoint. No client access:
    // a client write here is exactly the forged-certificate case.
    match /certificates/{certId} {
      allow read, write: if false;
    }

    // ─── quizAttempts ────────────────────────────────────────────
    // Server-graded mock-test attempts. Holds the served question refs and the
    // authoritative score a certificate cites. Client-readable would leak the
    // answer key; client-writable would put scoring back in the browser.
    match /quizAttempts/{attemptId} {
      allow read, write: if false;
    }

    // ─── quotas ──────────────────────────────────────────────────
    // Daily usage counters (see api/_quota.js). Server-only — a client that
    // could write these could reset its own free-tier ceiling.
    match /quotas/{quotaId} {
      allow read, write: if false;
    }

    // ─── Default deny ────────────────────────────────────────────
    // Any collection not explicitly matched above is locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
